{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;146;131;116m───  󰣇  ──────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "  ",
      "keyColor": "#d79921",
      "format": "{2}"
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "#b16286",
      "format": "{1} {4}"
    },
    {
      "type": "wm",
      "key": "  ",
      "keyColor": "#458588",
      "format": "{2} {5}"
    },
    {
      "type": "cpu",
      "key": "  ",
      "keyColor": "#b8bb26",
      "format": "{3}C/{4}T @ {7}"
    },
    {
      "type": "memory",
      "key": "  󰾆",
      "keyColor": "#cc241d",
      "format": "{1} / {2}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;146;131;116m───    ──────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "  \u001b[38;2;204;36;29m  \u001b[38;2;152;151;26m  \u001b[38;2;215;153;33m  \u001b[38;2;69;133;136m  \u001b[38;2;177;98;134m  \u001b[38;2;104;157;106m  \u001b[38;2;214;93;14m  \u001b[38;2;251;241;199m"
    },
    "break"
  ]
}
