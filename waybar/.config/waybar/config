{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "custom/recording"
  ],
  "modules-center": [
    "clock",
    "custom/prayer"
  ],
  "modules-right": [
    "sway/language",
    "tray",
    "pulseaudio",
    "custom/mic",
    "backlight",
    "network",
    "bluetooth",
    "power-profiles-daemon",
    "battery",
    "custom/power"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "on-click": "workspace",
    "tooltip": false
  },
  "sway/language": {
    "format-short": "{short}",
    "format-long": "{long} ({variant})",
    "tooltip": true
  },
  "clock": {
    "format": "{:%b %d  %I:%M %p}",
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n{:%I:%M %p}",
    "tooltip": true
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "on-scroll-down": "wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-click": "pavucontrol",
    "tooltip": false
  },
  "custom/mic": {
    "exec": "bash $HOME/.config/sway/scripts/mic.sh",
    "return-type": "json",
    "format": "{}",
    "on-click": "bash $HOME/.config/sway/scripts/mic.sh toggle",
    "tooltip": false,
    "interval": "once",
    "signal": 10
  },
  "backlight": {
    "format": "bl {percent}%",
    "device": "intel_backlight",
    "on-scroll-up": "brightnessctl set 5%-",
    "on-scroll-down": "brightnessctl set +5%",
    "tooltip": false
  },
  "network": {
    "format-wifi": "{ipaddr}",
    "format-ethernet": "{ipaddr}/{cidr}",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "kitty --class nmtui $HOME/.scripts/nmtui",
    "max-length": 30,
    "tooltip": false
  },
  "bluetooth": {
    "format": "bt {num_connections}",
    "format-disabled": "bt",
    "format-off": "bt",
    "format-on": "bt",
    "format-connected": "bt {num_connections}",
    "on-click": "kitty --class bluetui bluetui",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}%",
    "format-plugged": "bat {capacity}%",
    "format-alt": "{time}",
    "tooltip": false
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "tooltip": true,
    "format-icons": {
      "power-saver": "eco",
      "balanced": "bln",
      "performance": "prf"
    }
  },
  "tray": {
    "max-height": 16,
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "custom/recording": {
    "exec": "bash $HOME/.config/waybar/scripts/recording-timer.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 11
  },
  "custom/prayer": {
    "exec": "bash $HOME/.config/waybar/scripts/prayer.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 60,
    "on-click": "bash $HOME/.config/waybar/scripts/prayer-picker.sh",
    "tooltip": true
  }
}
